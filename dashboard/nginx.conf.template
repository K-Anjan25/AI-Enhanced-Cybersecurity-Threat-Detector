# Static dashboard with SPA fallback and an API proxy.
# The browser only ever talks to this origin; /api and /metrics are proxied to
# the backend so no cross-origin request is needed.
#
# Port 8080, not 80: binding below 1024 needs CAP_NET_BIND_SERVICE, which would
# mean running the container as root. The unprivileged nginx image listens here.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend per request, not at startup. A static proxy_pass to
    # `backend` makes nginx exit if that name is not resolvable yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream http://backend:8000;

    # WebSocket endpoint — must come before the generic /api/ location
    # so nginx applies upgrade headers to the actual WS path.
    location /api/v1/alerts/ws {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # REST API — all other /api/ requests
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }

    # Prometheus metrics scrape endpoint (read by dashboard drift page)
    location /metrics {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }

    # Health check endpoint
    location /healthz {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }

    # SPA fallback — everything else serves the dashboard
    location / {
        try_files $uri $uri/ /index.html;
    }
}
