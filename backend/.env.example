# Copy to .env and adjust. The dashboard authenticates ONLY through httpOnly
# cookies set by the backend — COOKIE_AUTH=true is required, otherwise login
# "succeeds" (200 + tokens in the body) but every authenticated request 401s
# (no cookie) and the client is bounced straight back to /login.

DATABASE_URL="sqlite:///./noctra_preview.db"
LLM_ENABLED=false

COOKIE_AUTH=true
# SameSite + Secure + Partitioned for the cross-site iframe preview (Arena).
# For plain-http local dev: COOKIE_SECURE=false, COOKIE_SAMESITE=lax.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_PARTITIONED=true

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="change-me-32-random-hex-bytes"
JWT_REFRESH_SECRET_KEY="change-me-32-random-hex-bytes"
# Dedicated key for connector credentials at rest — decouples from JWT rotation.
# Generate with: openssl rand -hex 32 (or base64). If unset, JWT_SECRET_KEY is used as fallback.
CONNECTOR_ENCRYPTION_KEY="change-me-32-random-hex-bytes-connector"
ANALYST_CHAT_RATE_LIMIT=20
# Scheduled polling — watches continuously without manual Sync (Phase 39)
CONNECTOR_POLL_ENABLED=true
CONNECTOR_POLL_INTERVAL_SECONDS=900
CONNECTOR_POLL_JITTER_SECONDS=60
# SSO / SCIM (Phase 40) — enterprise auth
SSO_ENABLED=false
SSO_OIDC_ISSUER="https://accounts.google.com"
SSO_OIDC_CLIENT_ID="your-client-id"
SSO_OIDC_CLIENT_SECRET="your-client-secret"
SSO_DEFAULT_ROLE="USER"
SCIM_ENABLED=false
SCIM_TOKEN="change-me-scim-bearer-token"
# SAML (Phase 41)
SSO_SAML_ENABLED=false
SSO_SAML_METADATA_URL="https://idp.example.com/metadata"
SSO_SAML_SSO_URL="https://idp.example.com/sso"
SSO_SAML_ENTITY_ID="https://noctra.example.com"
SSO_SAML_ACS_URL="https://noctra.example.com/api/v1/auth/sso/saml/callback"
# Connector OAuth (Phase 41) — GitHub App + Slack OAuth
GITHUB_OAUTH_CLIENT_ID="your-github-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-client-secret"
SLACK_OAUTH_CLIENT_ID="your-slack-client-id"
SLACK_OAUTH_CLIENT_SECRET="your-slack-client-secret"
CONNECTOR_OAUTH_REDIRECT_BASE="http://localhost:8000"
# SAML hardening (Phase 43)
SSO_SAML_REQUIRE_SIGNED_ASSERTIONS=false
SSO_SAML_REQUIRE_SIGNED_RESPONSE=false
SCIM_GROUPS_ROLE_MAPPING_ENABLED=true
# Compliance (Phase 45)
LOG_RETENTION_DAYS=30

# --- Digital Risk Protection -------------------------------------------------
# Certificate Transparency turns lookalike *candidates* into confirmed
# findings: if a cert exists for acme-login.com, someone has stood up
# infrastructure for it. crt.sh is free and needs no key, so this is opt-in by
# config because it makes an outbound call. Leave false in air-gapped installs.
DRP_CT_ENABLED=false
DRP_CT_URL="https://crt.sh/"
DRP_CT_TIMEOUT=15.0
# Not yet integrated. While unset, DRP reports these providers as unchecked
# rather than implying the org is clean.
DRP_DARKWEB_API_KEY=""
DRP_BREACH_API_KEY=""
