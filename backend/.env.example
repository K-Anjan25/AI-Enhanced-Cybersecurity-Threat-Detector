# Copy to .env and adjust. The dashboard authenticates ONLY through httpOnly
# cookies set by the backend — COOKIE_AUTH=true is required, otherwise login
# "succeeds" (200 + tokens in the body) but every authenticated request 401s
# (no cookie) and the client is bounced straight back to /login.

DATABASE_URL="sqlite:///./noctra_preview.db"
LLM_ENABLED=false

COOKIE_AUTH=true
# Dev runs over plain http (localhost / Vite proxy): Secure cookies would be
# dropped by browsers on http. Set true in production (nginx/HTTPS).
COOKIE_SECURE=false

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="change-me-32-random-hex-bytes"
JWT_REFRESH_SECRET_KEY="change-me-32-random-hex-bytes"
