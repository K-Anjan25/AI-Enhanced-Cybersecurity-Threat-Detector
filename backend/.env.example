# AEGIS backend — environment configuration example.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file must
# never contain a real secret (rule R-50).
#
# All variables are prefixed AEGIS_ and are validated at startup by
# app/core/config.py. A missing or invalid value stops the process with a
# message naming the variable.

# deployment environment: development | test | production
AEGIS_ENV=development

# REQUIRED. Minimum 32 characters, and not a placeholder or low-entropy value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=

AEGIS_SERVICE_NAME=aegis-backend
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis

AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=INFO
AEGIS_REQUEST_TIMEOUT_SECONDS=30

# Ingest limits (FR-01, FR-02, R-56)
AEGIS_MAX_FLOW_BATCH=1000
AEGIS_MAX_LOG_BATCH=5000
AEGIS_MAX_REQUEST_BYTES=8388608

AEGIS_ML_SERVICE_URL=http://localhost:8001

# Alert stream (FR-20): keep-alive interval for a quiet stream, and the cadence
# a disconnected dashboard polls at (architecture.md §14).
AEGIS_ALERT_STREAM_HEARTBEAT_SECONDS=15

# Outbound webhooks (FR-21, R-55). An empty allowlist denies every host: it is a
# fail-closed configuration, not a disabled check. Entries are hostnames,
# optionally prefixed '*.' (exactly one label beneath), comma-separated.
AEGIS_WEBHOOK_ALLOWLIST=
# The retry bound and per-attempt timeout are not environment settings yet:
# they are `RetryPolicy` and `WebhookSender` arguments with documented defaults
# (5 attempts, 1/2/4/8 s of full-jitter backoff, 10 s per attempt -- see D-040),
# because the pipeline that would read a setting does not exist yet. A knob
# nothing reads is worse than no knob.
