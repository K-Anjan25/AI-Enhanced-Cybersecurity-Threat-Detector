# One capture image for the engines that remain: Suricata (the flow and alert source) and
# tshark (opt-in). It replaces the four containers capture, zeek, suricata and tshark, which
# all ran with host networking and NET_ADMIN and posted to the same API. Engines are selected
# at runtime with AEGIS_CAPTURE_ENGINES (see capture_entrypoint.sh).
#
# Zeek was removed (option C): Suricata's eve.json `flow` events now supply the flows, through
# suricata_bridge.py --flows. Zeek's conn.log had richer per-connection fields (the trade-off
# of this change). Its memory share of the capture container has not been measured separately.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates \
        python3 python3-pip libpcap-dev dos2unix \
        suricata suricata-update tshark && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb && \
    rm -rf /usr/share/doc /usr/share/man /usr/share/locale

# Let the non-root wireshark group capture (tshark is opt-in; this keeps it usable).
RUN echo 'wireshark-common wireshark-common/install-setuid boolean true' | debconf-set-selections && \
    dpkg-reconfigure -f noninteractive wireshark-common 2>/dev/null || true

# Suricata rules (ET Open). The build fails if they cannot be fetched or do not load:
# before, `|| true` hid a failed download and the image shipped with no rules and no alerts.
# The download is retried because a single network blip should not break the build.
# Rules go to /etc/suricata/rules, the directory Suricata 6 reads by default. Writing to
# /var/lib/suricata/rules (suricata-update's default) made `suricata -T` fail with
# "No rule files match the pattern /etc/suricata/rules/suricata.rules".
RUN mkdir -p /etc/suricata/rules && \
    for attempt in 1 2 3; do \
        suricata-update -o /etc/suricata/rules && break; \
        if [ "$attempt" = 3 ]; then echo "suricata-update failed after 3 attempts" >&2; exit 1; fi; \
        sleep 15; \
    done && \
    test -s /etc/suricata/rules/suricata.rules && \
    suricata -T -c /etc/suricata/suricata.yaml -l /tmp && \
    echo "Suricata rules: $(grep -c '^alert' /etc/suricata/rules/suricata.rules) alert rules loaded"

# Flows come from Suricata's eve.json `flow` events. Fail the build if the shipped config
# does not emit them, rather than shipping an image with no flows.
RUN grep -Eq '^[[:space:]]*- flow[[:space:]]*$' /etc/suricata/suricata.yaml && \
    echo "Suricata eve-log emits flow events"

WORKDIR /app
# The spool directory exists in the image so a named volume mounted over it inherits
# writable ownership. The engines run as root because packet capture needs raw sockets;
# the privilege is granted explicitly by compose (cap_add: NET_ADMIN), not by --privileged.
RUN mkdir -p /var/lib/aegis-spool

COPY app/services/capture/bridges/suricata_bridge.py \
     app/services/capture/bridges/tcpdump_bridge.py \
     app/services/capture/bridges/shipper.py \
     app/services/capture/bridges/login.py \
     app/services/capture/bridges/capture_state.py ./
COPY app/services/capture/capture_entrypoint.sh app/services/capture/replay_pcap.sh ./

RUN dos2unix capture_entrypoint.sh replay_pcap.sh && chmod +x capture_entrypoint.sh replay_pcap.sh

CMD ["./capture_entrypoint.sh"]
