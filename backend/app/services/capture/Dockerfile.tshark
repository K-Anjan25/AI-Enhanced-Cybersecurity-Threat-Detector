FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV WIRESHARK_NON_ROOT=1

# Install tshark (Wireshark CLI) and Python
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tshark \
        python3 python3-pip \
        libpcap-dev && \
    rm -rf /var/lib/apt/lists/*

# Allow non-root capture
RUN echo 'wireshark-common wireshark-common/install-setuid boolean true' | debconf-set-selections && \
    dpkg-reconfigure -f noninteractive wireshark-common 2>/dev/null || true

WORKDIR /app

COPY app/services/capture/bridges/tcpdump_bridge.py .
COPY app/services/capture/tshark_entrypoint.sh .
RUN chmod +x tshark_entrypoint.sh

CMD ["./tshark_entrypoint.sh"]