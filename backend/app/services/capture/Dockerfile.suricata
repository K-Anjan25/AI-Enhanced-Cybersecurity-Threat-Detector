FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Suricata and Python
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        suricata \
        suricata-update \
        python3 python3-pip \
        curl libpcap-dev dos2unix && \
    rm -rf /var/lib/apt/lists/*

# Update Suricata rules
RUN suricata-update 2>/dev/null || true

WORKDIR /app

COPY app/services/capture/bridges/suricata_bridge.py .
COPY app/services/capture/suricata_entrypoint.sh .

RUN dos2unix suricata_entrypoint.sh && chmod +x suricata_entrypoint.sh

CMD ["./suricata_entrypoint.sh"]