# Copy to docker/.env (git-ignored) and edit before running the stack:
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yml up
#
# docker compose reads .env from the directory of the compose file, so this
# file must be named docker/.env to be picked up.

# REQUIRED. Random, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=

# The first admin account. The compose defaults are a local development
# credential. The capture, zeek, suricata and tshark services log in with these
# same values, so change them together. Set both before any shared use.
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@aegis.local
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=

# Linux interface name for the capture services. Leave unset for the per-service
# defaults (see backend/app/services/capture/bridges/README.md).
# AEGIS_CAPTURE_INTERFACE=wlan0

# Set to true only on a private development stack, to allow one in-memory first
# account to be set up through the API.
AEGIS_DEV_AUTH_SETUP_ENABLED=false
