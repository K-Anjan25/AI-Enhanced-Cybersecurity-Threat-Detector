# Copy to docker/.env (git-ignored) and edit before running the stack:
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yml up
#
# docker compose reads .env from the directory of the compose file, so this
# file must be named docker/.env to be picked up.

# REQUIRED. Random, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=

# The first admin account. The compose defaults are a local development
# credential. The capture, zeek, suricata and tshark services log in with these
# same values, and they refuse to start while the password is the development
# default or empty. Set the password here before running the capture services.
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@aegis.local
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=

# Network capture runs in one container. Choose the engines and, per engine, the Linux
# interface to read. Default: suricata on eth0 (it supplies flows too). tshark is
# opt-in because it duplicates suricata's flows; add it to the list to enable it.
# Zeek is no longer in the image.
# AEGIS_CAPTURE_ENGINES=suricata
# AEGIS_ZEEK_INTERFACE=wlan0
# AEGIS_SURICATA_INTERFACE=wlan0
# AEGIS_TSHARK_INTERFACE=any

# Set to true only on a private development stack, to allow one in-memory first
# account to be set up through the API.
AEGIS_DEV_AUTH_SETUP_ENABLED=false

# REQUIRED. Shared secret between the backend and the ML service (model registry and
# scoring). Random, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_ML_SERVICE_TOKEN=

# Self-service viewer signup on the local stack (set false to close the sign-up page).
AEGIS_SIGNUP_ENABLED=true
