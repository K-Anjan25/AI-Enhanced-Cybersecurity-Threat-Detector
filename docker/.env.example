# Copy to docker/.env (git-ignored) and edit before running the stack:
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yml up
#
# docker compose reads .env from the directory of the compose file, so this
# file must be named docker/.env to be picked up.

# REQUIRED. Random, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=

# The first admin account used by the dashboard and the Docker-managed capture
# service. Choose a strong password; capture refuses the development default.
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@aegis.local
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=

# All three capture engines are included in the main Docker capture service by
# default. Zeek emits canonical flows, Suricata emits IDS/protocol logs, and
# tshark emits selected additional protocol details as logs (no duplicate flows).
# Capture is real host-interface traffic on Linux; Docker Desktop runs in a VM and
# may not expose the host adapter. Override interfaces with Linux device names.
# AEGIS_CAPTURE_ENGINES=zeek,suricata,tshark
# AEGIS_CAPTURE_INTERFACE=eth0
# AEGIS_ZEEK_INTERFACE=eth0
# AEGIS_SURICATA_INTERFACE=eth0
# AEGIS_TSHARK_INTERFACE=any
# AEGIS_CAPTURE_SENSOR_ID=docker-host-capture
# AEGIS_CAPTURE_HEARTBEAT_SECONDS=15

# Set to true only on a private development stack, to allow one in-memory first
# account to be set up through the API.
AEGIS_DEV_AUTH_SETUP_ENABLED=false
