ml-service/artifacts/*
!ml-service/artifacts/.gitkeep
*.pt
*.pth
*.onnx
*.safetensors

# --- python ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- node / dashboard -----------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

